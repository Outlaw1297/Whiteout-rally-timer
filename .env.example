# Database
DATABASE_URL="postgresql://rally:rally@localhost:5432/rally_timer?schema=public"

# Server
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=development

# Session (min 32 chars in production)
SESSION_SECRET="dev-session-secret-min-32-chars!!"

# VAPID keys for Web Push (generate with: npm run generate:vapid)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
