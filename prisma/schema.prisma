generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CALLER
  DEVELOPER
}

enum RallyEventStatus {
  DRAFT
  READY
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  WAITING
  LAUNCHED
  MISSED
}

enum NotificationEventType {
  RALLY_STARTED
  WARNING_60
  WARNING_30
  WARNING_15
  WARNING_10
  WARNING_5
  WARNING_3
  LAUNCH
}

enum NotificationEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  displayName     String
  passwordHash    String
  role            UserRole @default(CALLER)
  active          Boolean  @default(true)
  /** Optional warning leads in seconds before throw, e.g. [30, 10, 5]. Launch + rally-start are always sent. */
  warningLeadsSeconds Json @default("[10, 5]")
  /** @deprecated Prefer warningLeadsSeconds — kept for migration compatibility */
  warn10Enabled   Boolean  @default(true)
  /** @deprecated Prefer warningLeadsSeconds */
  warn5Enabled    Boolean  @default(true)
  /** @deprecated Launch is always required */
  launchEnabled   Boolean  @default(true)
  /** Learned push lead (ms) — rolling avg across active devices, for admin debug */
  deliveryLeadMs      Int?
  deliverySampleCount Int      @default(0)
  /** Last successful push calibration / delivery-feedback sample */
  lastCalibratedAt    DateTime? @db.Timestamptz(3)
  /** Last successful login */
  lastLoginAt         DateTime? @db.Timestamptz(3)
  /** Last presence / live ping from an open app session */
  lastSeenAt          DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  assignments       RallyAssignment[]
  pushSubscriptions PushSubscription[]

  @@index([role, active])
}

model RallyEvent {
  id                    String           @id @default(uuid())
  name                  String
  targetArrivalTime     DateTime?        @db.Timestamptz(3)
  gatherDurationSeconds Int              @default(300)
  /** Seconds after GO before the first caller's launch time */
  firstCallerLeadSeconds Int             @default(3)
  /** Send push notifications early by this many ms to offset delivery delay */
  pushLeadMs            Int              @default(1000)
  status                RallyEventStatus @default(DRAFT)
  isTestMode            Boolean          @default(false)
  /** Pin for quick-switch drawer */
  pinned                Boolean          @default(false)
  /** Manual sort order in template lists (lower first) */
  sortOrder             Int              @default(0)
  startedAt             DateTime?        @db.Timestamptz(3)
  completedAt           DateTime?        @db.Timestamptz(3)
  cancelledAt           DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  assignments RallyAssignment[]

  @@index([status])
  @@index([targetArrivalTime])
  @@index([pinned, sortOrder])
}

model RallyAssignment {
  id                   String           @id @default(uuid())
  rallyEventId         String
  callerName           String
  userId               String?
  marchDurationSeconds Int
  /** Seconds relative to shared target — positive = hit later, negative = hit earlier */
  arrivalOffsetSeconds Int              @default(0)
  launchTime           DateTime?        @db.Timestamptz(3)
  expectedArrivalTime  DateTime?        @db.Timestamptz(3)
  status               AssignmentStatus @default(WAITING)
  launchedConfirmedAt  DateTime?        @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  rallyEvent         RallyEvent          @relation(fields: [rallyEventId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  notificationEvents NotificationEvent[]

  @@unique([rallyEventId, callerName])
  @@index([rallyEventId])
  @@index([userId])
  @@index([launchTime])
  @@index([status])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  platform  String?
  userAgent String?
  active    Boolean  @default(true)
  /** Learned ms to send early so this device receives alerts on time */
  deliveryLeadMs      Int @default(1000)
  deliverySampleCount Int @default(0)
  /** Recent valid signed-receipt window used for conservative percentile timing. */
  deliveryP50Ms       Int?
  deliveryP90Ms       Int?
  deliveryWindowCount Int @default(0)
  /** Last time this device contributed a delivery timing sample */
  lastCalibratedAt    DateTime? @db.Timestamptz(3)
  /** Last presence ping or delivery feedback from this device */
  lastSeenAt          DateTime? @db.Timestamptz(3)
  /** Stable per-install id from the client (survives new Web Push endpoints). */
  deviceId            String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([lastSeenAt])
  @@index([userId, deviceId])
}

model NotificationEvent {
  id                String                  @id @default(uuid())
  rallyAssignmentId String
  type              NotificationEventType
  scheduledAt       DateTime                @db.Timestamptz(3)
  sentAt            DateTime?               @db.Timestamptz(3)
  status            NotificationEventStatus @default(PENDING)
  error             String?
  latencyMs         Int?
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)

  assignment RallyAssignment @relation(fields: [rallyAssignmentId], references: [id], onDelete: Cascade)

  @@unique([rallyAssignmentId, type])
  @@index([scheduledAt, status])
  @@index([rallyAssignmentId])
}

/** Auto-generated VAPID keys persisted across deploys (env vars optional override). */
model VapidConfig {
  id         String   @id @default("default")
  publicKey  String
  privateKey String
  subject    String   @default("mailto:admin@example.com")
  source     String   @default("generated")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

/**
 * Durable developer log: logins, device register/unbind, test pushes, rally sends.
 * No FK to User — rows stay after an account is deleted.
 */
model ActivityLog {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  kind           String
  success        Boolean  @default(true)
  userId         String?
  username       String?
  displayName    String?
  deviceId       String?
  subscriptionId String?
  platform       String?
  message        String?
  error          String?
  meta           Json?

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

/**
 * One row per push/device attempt. Provider acceptance and device-side receipts
 * update the same row so the developer UI can show an end-to-end timeline.
 * Endpoints, encryption keys, and notification bodies are intentionally omitted.
 */
model PushDeliveryAttempt {
  id                   String    @id @default(uuid())
  dispatchId           String    @unique
  source               String
  userId               String?
  username             String?
  displayName          String?
  subscriptionId       String?
  deviceId             String?
  platform             String?
  endpointHost         String?
  endpointFingerprint  String?
  vapidFingerprint     String?
  notificationType     String?
  rallyId              String?
  assignmentId         String?
  /** Payload included an OS-renderable Declarative Web Push fallback. */
  declarativePayload   Boolean   @default(false)
  /** Intended user-visible time carried in the push payload. */
  targetAt             DateTime? @db.Timestamptz(3)
  providerStatus       Int?
  providerMessageId    String?
  providerDurationMs   Int?
  providerAcceptedAt   DateTime? @db.Timestamptz(3)
  providerError        String?
  receivedAt           DateTime? @db.Timestamptz(3)
  /** Device wall-clock receipt time, accepted only when close to server time. */
  clientReceivedAt     DateTime? @db.Timestamptz(3)
  /** Set atomically when this dispatch updates the learned device lead. */
  calibrationAppliedAt DateTime? @db.Timestamptz(3)
  /** Measured server-send to signed device-receipt round trip. */
  calibrationRoundTripMs Int?
  /** Device receipt offset from the intended user-visible target. */
  calibrationDelayMs   Int?
  /** Recent-window timing summary used when this sample was applied. */
  calibrationP50Ms       Int?
  calibrationP90Ms       Int?
  calibrationWindowCount Int?
  calibrationMethod      String?
  displayedAt          DateTime? @db.Timestamptz(3)
  displayFailedAt      DateTime? @db.Timestamptz(3)
  displayError         String?
  clickedAt            DateTime? @db.Timestamptz(3)
  serviceWorkerVersion String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([deviceId, createdAt])
  @@index([providerStatus, createdAt])
  @@index([notificationType, createdAt])
}
